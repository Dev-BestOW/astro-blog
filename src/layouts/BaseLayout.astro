---
import { siteConfig } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** OG 이미지 절대/상대 경로 (기본: satori로 생성한 사이트 기본 PNG) */
  image?: string;
  /** 글 상세면 'article' */
  type?: 'website' | 'article';
  /** 페이지별 JSON-LD 구조화 데이터 (미지정 시 홈에서 WebSite 스키마 사용) */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteConfig.description,
  image = '/og/default.png',
  type = 'website',
  jsonLd,
} = Astro.props;

// 네이버 권장 제목 길이(40자) 안에 들 때만 사이트 이름을 붙인다 — 넘치면 검색 결과에서 글 제목이 잘린다
const TITLE_MAX = 40;
const withSite = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const pageTitle = title && withSite.length > TITLE_MAX ? title : withSite;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// 네이버 "파비콘": href 는 상대 경로가 아닌 절대 경로. 32×32 정사각형 SVG(권장 32px 이상).
const favicon = new URL('/favicon.svg', Astro.site);
const rssUrl = new URL('/rss.xml', Astro.site);

// JSON-LD: 전달받은 스키마 우선, 없으면 홈(`/`)에서만 WebSite 기본값.
const structuredData: Record<string, unknown> | undefined =
  jsonLd ??
  (Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.title,
        url: siteConfig.url,
        description: siteConfig.description,
        inLanguage: siteConfig.locale,
      }
    : undefined);

// `</script>` 조기 종료 방지를 위해 `<`를 이스케이프.
const jsonLdText = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={rssUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- 검색엔진 소유확인 (값이 있을 때만) -->
    {
      siteConfig.verification.naver && (
        <meta name="naver-site-verification" content={siteConfig.verification.naver} />
      )
    }
    {
      siteConfig.verification.google && (
        <meta name="google-site-verification" content={siteConfig.verification.google} />
      )
    }

    <!-- Google AdSense: 게시자 ID 가 있을 때만(사이트 소유 확인 메타 + 광고 스크립트) -->
    {
      siteConfig.ads.adsenseClient && (
        <>
          <meta name="google-adsense-account" content={siteConfig.ads.adsenseClient} />
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.ads.adsenseClient}`}
            crossorigin="anonymous"
          />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD 구조화 데이터 -->
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}

    <!-- 다크모드 FOUC 방지: 렌더 전 테마 결정 -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow dark:focus:bg-neutral-900"
    >
      본문으로 건너뛰기
    </a>
    <Header />
    <main id="main" tabindex="-1" class="mx-auto max-w-2xl px-4 py-10 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
