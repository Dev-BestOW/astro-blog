---
import { siteConfig } from '../config';

// 글 끝 광고 칸. AdSense 광고 단위가 있으면 AdSense, 없고 애드핏 단위가 있으면 애드핏, 둘 다 없으면 아무것도 그리지 않는다.
// 광고가 늦게 채워져도 아래 내용이 밀리지 않게(CLS) 높이를 미리 잡는다. 검색 색인(pagefind)에서는 뺀다.
const { adsenseClient, adsenseSlot, adfitUnit, adfitWidth, adfitHeight } = siteConfig.ads;
const provider = adsenseClient && adsenseSlot ? 'adsense' : adfitUnit ? 'adfit' : null;
---

{
  provider && (
    <aside
      aria-label="광고"
      class="mt-12 border-t border-neutral-200 pt-6 dark:border-neutral-800"
      data-pagefind-ignore
    >
      <p class="mb-2 text-xs text-neutral-600 dark:text-neutral-400">광고</p>
      <div
        class="flex justify-center"
        style={`min-height: ${provider === 'adfit' ? adfitHeight : 100}px`}
      >
        {provider === 'adsense' ? (
          <ins
            class="adsbygoogle"
            style="display:block; width:100%"
            data-ad-client={adsenseClient}
            data-ad-slot={adsenseSlot}
            data-ad-format="auto"
            data-full-width-responsive="true"
          />
        ) : (
          <ins
            class="kakao_ad_area"
            style="display:none"
            data-ad-unit={adfitUnit}
            data-ad-width={String(adfitWidth)}
            data-ad-height={String(adfitHeight)}
          />
        )}
      </div>
    </aside>
  )
}

{
  !provider && import.meta.env.DEV && (
    <p class="mt-12 border-t border-neutral-200 pt-8 text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
      광고 미설정 — <code>src/config.ts</code>의 <code>ads</code>를 채우면 이 자리에 광고가
      들어갑니다. (이 안내는 개발 모드에서만 표시)
    </p>
  )
}

{
  provider === 'adsense' && (
    <script is:inline set:html="(window.adsbygoogle = window.adsbygoogle || []).push({});" />
  )
}

{
  provider === 'adfit' && (
    <script is:inline async src="https://t1.daumcdn.net/kas/static/ba.min.js" />
  )
}
