---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-2xl px-4 py-8 text-sm text-neutral-500 dark:text-neutral-400">
    <p>© {year} {siteConfig.author}. Built with Astro.</p>
    <nav aria-label="사이트 정보" class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      <a href="/about/" class="hover:text-accent hover:underline">소개</a>
      <a href="https://github.com/Dev-BestOW" class="hover:text-accent hover:underline">GitHub</a>
      <a href="/rss.xml" class="hover:text-accent hover:underline">RSS</a>
      <a href="/privacy/" class="hover:text-accent hover:underline">개인정보처리방침</a>
    </nav>
  </div>
</footer>
