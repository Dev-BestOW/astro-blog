---
import type { Post } from '../utils/posts';
import { formatDate } from '../utils/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
// 태그 링크는 누름 영역 24px 이상(WCAG 2.5.8) — py-1 로 넓히고 -my-1 로 줄 간격은 그대로 둔다(한 줄이라 겹치지 않음)
---

<article class="group py-6">
  <a href={`/posts/${post.id}/`} class="block">
    <h2 class="text-xl font-semibold tracking-tight group-hover:text-accent">
      {title}
    </h2>
    <p class="mt-2 line-clamp-2 text-neutral-600 dark:text-neutral-400">
      {description}
    </p>
  </a>
  <div
    class="mt-3 flex flex-col gap-1 text-sm text-neutral-600 sm:flex-row sm:items-center sm:gap-3 dark:text-neutral-400"
  >
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {
      tags.length > 0 && (
        <div class="flex gap-2">
          {tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="-my-1 py-1 hover:text-accent">
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
